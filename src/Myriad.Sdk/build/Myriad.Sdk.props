<Project>

    <PropertyGroup>
        <!-- LatestMajor runs Myriad on the newest installed .NET runtime rather than the oldest one it
             accepts, so plugins built for a newer runtime than Myriad's own target framework can load. -->
        <MyriadSdk_Generator_ExeHost Condition="'$(MyriadSdk_Generator_ExeHost)' == ''">dotnet --roll-forward LatestMajor </MyriadSdk_Generator_ExeHost>
        <!-- The Myriad CLI ships inside this package (see Myriad.Sdk.proj). It used to be fetched by a
             PackageDownload declared here, but NuGet evaluates a project for restore without the
             build props of its packages (ExcludeRestorePackageImports=true), so restore never saw it
             and the CLI was never downloaded. -->
        <MyriadSdk_Generator_Exe Condition="'$(MyriadSdk_Generator_Exe)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/net8.0/any/Myriad.dll'))</MyriadSdk_Generator_Exe>
    </PropertyGroup>

</Project>
